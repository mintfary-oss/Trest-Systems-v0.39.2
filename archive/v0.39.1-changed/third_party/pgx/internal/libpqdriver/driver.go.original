// Package libpqdriver provides a database/sql PostgreSQL driver backed by
// the system libpq library. It is intentionally compact but implements the
// standard connection, query, transaction, ping, and statement interfaces
// required by Trest Systems.
package libpqdriver

/*
#cgo pkg-config: libpq
#include <stdlib.h>
#include <libpq-fe.h>

static PGresult* trest_exec_params(PGconn *conn, const char *query, int nParams, char **values) {
    return PQexecParams(conn, query, nParams, NULL, (const char * const *)values, NULL, NULL, 0);
}
*/
import "C"

import (
	"context"
	"database/sql/driver"
	"encoding/hex"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"reflect"
	"strconv"
	"strings"
	"sync"
	"time"
	"unsafe"
)

// Driver opens libpq connections from PostgreSQL URL or keyword DSNs.
type Driver struct{}

func (Driver) Open(name string) (driver.Conn, error) {
	cname := C.CString(name)
	defer C.free(unsafe.Pointer(cname))
	conn := C.PQconnectdb(cname)
	if conn == nil {
		return nil, errors.New("postgres: PQconnectdb returned nil")
	}
	if C.PQstatus(conn) != C.CONNECTION_OK {
		err := connectionError(conn)
		C.PQfinish(conn)
		return nil, err
	}
	return &Conn{conn: conn}, nil
}

// Error reports a PostgreSQL server or libpq failure.
type Error struct {
	Message  string
	SQLState string
}

func (e *Error) Error() string {
	if e.SQLState != "" {
		return fmt.Sprintf("postgres: %s (SQLSTATE %s)", e.Message, e.SQLState)
	}
	return "postgres: " + e.Message
}

// Conn is a single libpq connection managed by database/sql.
type Conn struct {
	mu     sync.Mutex
	conn   *C.PGconn
	closed bool
}

var (
	_ driver.Conn               = (*Conn)(nil)
	_ driver.ConnPrepareContext = (*Conn)(nil)
	_ driver.ExecerContext      = (*Conn)(nil)
	_ driver.QueryerContext     = (*Conn)(nil)
	_ driver.Pinger             = (*Conn)(nil)
	_ driver.ConnBeginTx        = (*Conn)(nil)
	_ driver.NamedValueChecker  = (*Conn)(nil)
	_ driver.Validator          = (*Conn)(nil)
)

func (c *Conn) Prepare(query string) (driver.Stmt, error) {
	return c.PrepareContext(context.Background(), query)
}

func (c *Conn) PrepareContext(ctx context.Context, query string) (driver.Stmt, error) {
	if err := ctx.Err(); err != nil {
		return nil, err
	}
	if !c.IsValid() {
		return nil, driver.ErrBadConn
	}
	return &Stmt{conn: c, query: query}, nil
}

func (c *Conn) Close() error {
	c.mu.Lock()
	defer c.mu.Unlock()
	if c.closed {
		return nil
	}
	c.closed = true
	if c.conn != nil {
		C.PQfinish(c.conn)
		c.conn = nil
	}
	return nil
}

func (c *Conn) Begin() (driver.Tx, error) {
	return c.BeginTx(context.Background(), driver.TxOptions{})
}

func (c *Conn) BeginTx(ctx context.Context, opts driver.TxOptions) (driver.Tx, error) {
	parts := []string{"BEGIN"}
	switch opts.Isolation {
	case driver.IsolationLevel(0):
	case driver.IsolationLevel(1):
		parts = append(parts, "ISOLATION LEVEL READ UNCOMMITTED")
	case driver.IsolationLevel(2):
		parts = append(parts, "ISOLATION LEVEL READ COMMITTED")
	case driver.IsolationLevel(4):
		parts = append(parts, "ISOLATION LEVEL REPEATABLE READ")
	case driver.IsolationLevel(6):
		parts = append(parts, "ISOLATION LEVEL SERIALIZABLE")
	default:
		return nil, fmt.Errorf("postgres: unsupported isolation level %d", opts.Isolation)
	}
	if opts.ReadOnly {
		parts = append(parts, "READ ONLY")
	}
	if _, err := c.ExecContext(ctx, strings.Join(parts, " "), nil); err != nil {
		return nil, err
	}
	return &Tx{conn: c}, nil
}

func (c *Conn) Ping(ctx context.Context) error {
	rows, err := c.QueryContext(ctx, "SELECT 1", nil)
	if err != nil {
		return err
	}
	return rows.Close()
}

func (c *Conn) CheckNamedValue(_ *driver.NamedValue) error { return nil }

func (c *Conn) IsValid() bool {
	c.mu.Lock()
	defer c.mu.Unlock()
	return !c.closed && c.conn != nil && C.PQstatus(c.conn) == C.CONNECTION_OK
}

func (c *Conn) ExecContext(ctx context.Context, query string, args []driver.NamedValue) (driver.Result, error) {
	if err := ctx.Err(); err != nil {
		return nil, err
	}
	c.mu.Lock()
	defer c.mu.Unlock()
	res, err := c.execLocked(query, args)
	if err != nil {
		return nil, err
	}
	defer C.PQclear(res)
	if err := resultError(res); err != nil {
		return nil, err
	}
	return commandResult{affected: commandRows(res)}, nil
}

func (c *Conn) QueryContext(ctx context.Context, query string, args []driver.NamedValue) (driver.Rows, error) {
	if err := ctx.Err(); err != nil {
		return nil, err
	}
	c.mu.Lock()
	defer c.mu.Unlock()
	res, err := c.execLocked(query, args)
	if err != nil {
		return nil, err
	}
	if err := resultError(res); err != nil {
		C.PQclear(res)
		return nil, err
	}
	status := C.PQresultStatus(res)
	if status != C.PGRES_TUPLES_OK && status != C.PGRES_SINGLE_TUPLE {
		C.PQclear(res)
		return &Rows{columns: []string{}, closed: true}, nil
	}
	count := int(C.PQnfields(res))
	columns := make([]string, count)
	oids := make([]uint32, count)
	for i := 0; i < count; i++ {
		columns[i] = C.GoString(C.PQfname(res, C.int(i)))
		oids[i] = uint32(C.PQftype(res, C.int(i)))
	}
	return &Rows{res: res, columns: columns, oids: oids, rowCount: int(C.PQntuples(res))}, nil
}

func (c *Conn) execLocked(query string, args []driver.NamedValue) (*C.PGresult, error) {
	if c.closed || c.conn == nil {
		return nil, driver.ErrBadConn
	}
	cquery := C.CString(query)
	defer C.free(unsafe.Pointer(cquery))

	var values **C.char
	var allocated unsafe.Pointer
	stringsAllocated := make([]*C.char, 0, len(args))
	if len(args) > 0 {
		allocated = C.malloc(C.size_t(len(args)) * C.size_t(unsafe.Sizeof(uintptr(0))))
		if allocated == nil {
			return nil, errors.New("postgres: allocate query parameters")
		}
		defer C.free(allocated)
		valueSlice := unsafe.Slice((**C.char)(allocated), len(args))
		for i, arg := range args {
			encoded, isNull, err := encodeValue(arg.Value)
			if err != nil {
				for _, item := range stringsAllocated {
					C.free(unsafe.Pointer(item))
				}
				return nil, fmt.Errorf("postgres: parameter %d: %w", i+1, err)
			}
			if isNull {
				valueSlice[i] = nil
				continue
			}
			item := C.CString(encoded)
			stringsAllocated = append(stringsAllocated, item)
			valueSlice[i] = item
		}
		values = (**C.char)(allocated)
	}
	defer func() {
		for _, item := range stringsAllocated {
			C.free(unsafe.Pointer(item))
		}
	}()

	res := C.trest_exec_params(c.conn, cquery, C.int(len(args)), values)
	if res == nil {
		return nil, connectionError(c.conn)
	}
	return res, nil
}

func connectionError(conn *C.PGconn) error {
	if conn == nil {
		return errors.New("postgres: connection unavailable")
	}
	message := strings.TrimSpace(C.GoString(C.PQerrorMessage(conn)))
	if message == "" {
		message = "connection failure"
	}
	return &Error{Message: message}
}

func resultError(res *C.PGresult) error {
	status := C.PQresultStatus(res)
	switch status {
	case C.PGRES_COMMAND_OK, C.PGRES_TUPLES_OK, C.PGRES_SINGLE_TUPLE, C.PGRES_EMPTY_QUERY:
		return nil
	default:
		message := strings.TrimSpace(C.GoString(C.PQresultErrorMessage(res)))
		state := ""
		if field := C.PQresultErrorField(res, C.PG_DIAG_SQLSTATE); field != nil {
			state = C.GoString(field)
		}
		if message == "" {
			message = C.GoString(C.PQresStatus(status))
		}
		return &Error{Message: message, SQLState: state}
	}
}

func commandRows(res *C.PGresult) int64 {
	text := C.GoString(C.PQcmdTuples(res))
	if text == "" {
		return 0
	}
	n, _ := strconv.ParseInt(text, 10, 64)
	return n
}

func encodeValue(value any) (string, bool, error) {
	if value == nil {
		return "", true, nil
	}
	if valuer, ok := value.(driver.Valuer); ok {
		converted, err := valuer.Value()
		if err != nil {
			return "", false, err
		}
		return encodeValue(converted)
	}
	switch v := value.(type) {
	case string:
		return v, false, nil
	case []byte:
		return `\x` + hex.EncodeToString(v), false, nil
	case bool:
		return strconv.FormatBool(v), false, nil
	case int:
		return strconv.Itoa(v), false, nil
	case int8:
		return strconv.FormatInt(int64(v), 10), false, nil
	case int16:
		return strconv.FormatInt(int64(v), 10), false, nil
	case int32:
		return strconv.FormatInt(int64(v), 10), false, nil
	case int64:
		return strconv.FormatInt(v, 10), false, nil
	case uint:
		return strconv.FormatUint(uint64(v), 10), false, nil
	case uint8:
		return strconv.FormatUint(uint64(v), 10), false, nil
	case uint16:
		return strconv.FormatUint(uint64(v), 10), false, nil
	case uint32:
		return strconv.FormatUint(uint64(v), 10), false, nil
	case uint64:
		return strconv.FormatUint(v, 10), false, nil
	case float32:
		return strconv.FormatFloat(float64(v), 'g', -1, 32), false, nil
	case float64:
		return strconv.FormatFloat(v, 'g', -1, 64), false, nil
	case time.Time:
		return v.Format(time.RFC3339Nano), false, nil
	case json.RawMessage:
		return string(v), false, nil
	}

	rv := reflect.ValueOf(value)
	if rv.Kind() == reflect.Pointer {
		if rv.IsNil() {
			return "", true, nil
		}
		return encodeValue(rv.Elem().Interface())
	}
	if rv.Kind() == reflect.Slice || rv.Kind() == reflect.Array {
		parts := make([]string, rv.Len())
		for i := 0; i < rv.Len(); i++ {
			item, isNull, err := encodeValue(rv.Index(i).Interface())
			if err != nil {
				return "", false, err
			}
			if isNull {
				parts[i] = "NULL"
				continue
			}
			parts[i] = `"` + strings.ReplaceAll(strings.ReplaceAll(item, `\`, `\\`), `"`, `\"`) + `"`
		}
		return "{" + strings.Join(parts, ",") + "}", false, nil
	}
	if rv.Kind() == reflect.Map || rv.Kind() == reflect.Struct {
		encoded, err := json.Marshal(value)
		if err == nil {
			return string(encoded), false, nil
		}
	}
	if stringer, ok := value.(fmt.Stringer); ok {
		return stringer.String(), false, nil
	}
	return "", false, fmt.Errorf("unsupported value type %T", value)
}

// Stmt is a lightweight client-side prepared statement. libpq parameterizes
// each execution through PQexecParams, so no server-side statement lifecycle
// is needed here.
type Stmt struct {
	conn  *Conn
	query string
}

var (
	_ driver.Stmt             = (*Stmt)(nil)
	_ driver.StmtExecContext  = (*Stmt)(nil)
	_ driver.StmtQueryContext = (*Stmt)(nil)
)

func (s *Stmt) Close() error  { return nil }
func (s *Stmt) NumInput() int { return -1 }
func (s *Stmt) Exec(args []driver.Value) (driver.Result, error) {
	return s.ExecContext(context.Background(), namedValues(args))
}
func (s *Stmt) Query(args []driver.Value) (driver.Rows, error) {
	return s.QueryContext(context.Background(), namedValues(args))
}
func (s *Stmt) ExecContext(ctx context.Context, args []driver.NamedValue) (driver.Result, error) {
	return s.conn.ExecContext(ctx, s.query, args)
}
func (s *Stmt) QueryContext(ctx context.Context, args []driver.NamedValue) (driver.Rows, error) {
	return s.conn.QueryContext(ctx, s.query, args)
}

func namedValues(values []driver.Value) []driver.NamedValue {
	out := make([]driver.NamedValue, len(values))
	for i, value := range values {
		out[i] = driver.NamedValue{Ordinal: i + 1, Value: value}
	}
	return out
}

type Tx struct {
	conn *Conn
	done bool
}

func (t *Tx) Commit() error {
	if t.done {
		return errors.New("postgres: transaction already closed")
	}
	t.done = true
	_, err := t.conn.ExecContext(context.Background(), "COMMIT", nil)
	return err
}

func (t *Tx) Rollback() error {
	if t.done {
		return nil
	}
	t.done = true
	_, err := t.conn.ExecContext(context.Background(), "ROLLBACK", nil)
	return err
}

type commandResult struct{ affected int64 }

func (r commandResult) LastInsertId() (int64, error) {
	return 0, errors.New("postgres: LastInsertId is not supported; use RETURNING")
}
func (r commandResult) RowsAffected() (int64, error) { return r.affected, nil }

// Rows owns a PGresult until Close.
type Rows struct {
	res      *C.PGresult
	columns  []string
	oids     []uint32
	row      int
	rowCount int
	closed   bool
}

var _ driver.Rows = (*Rows)(nil)

func (r *Rows) Columns() []string { return append([]string(nil), r.columns...) }

func (r *Rows) Close() error {
	if r.closed {
		return nil
	}
	r.closed = true
	if r.res != nil {
		C.PQclear(r.res)
		r.res = nil
	}
	return nil
}

func (r *Rows) Next(dest []driver.Value) error {
	if r.closed || r.res == nil || r.row >= r.rowCount {
		_ = r.Close()
		return io.EOF
	}
	if len(dest) < len(r.columns) {
		return fmt.Errorf("postgres: destination has %d columns, need %d", len(dest), len(r.columns))
	}
	for col := range r.columns {
		if C.PQgetisnull(r.res, C.int(r.row), C.int(col)) != 0 {
			dest[col] = nil
			continue
		}
		length := int(C.PQgetlength(r.res, C.int(r.row), C.int(col)))
		ptr := C.PQgetvalue(r.res, C.int(r.row), C.int(col))
		raw := C.GoBytes(unsafe.Pointer(ptr), C.int(length))
		dest[col] = decodeValue(r.oids[col], raw)
	}
	r.row++
	return nil
}

func decodeValue(oid uint32, raw []byte) driver.Value {
	s := string(raw)
	switch oid {
	case 16: // bool
		return s == "t" || strings.EqualFold(s, "true") || s == "1"
	case 20, 21, 23, 26: // int8, int2, int4, oid
		if n, err := strconv.ParseInt(s, 10, 64); err == nil {
			return n
		}
	case 700, 701, 1700: // float4, float8, numeric
		if n, err := strconv.ParseFloat(s, 64); err == nil {
			return n
		}
	case 17: // bytea text format
		if strings.HasPrefix(s, `\x`) {
			if decoded, err := hex.DecodeString(strings.TrimPrefix(s, `\x`)); err == nil {
				return decoded
			}
		}
		return append([]byte(nil), raw...)
	case 1082: // date
		if value, err := time.Parse("2006-01-02", s); err == nil {
			return value
		}
	case 1114, 1184: // timestamp / timestamptz
		for _, layout := range []string{
			time.RFC3339Nano,
			"2006-01-02 15:04:05.999999999Z07:00",
			"2006-01-02 15:04:05.999999999-07",
			"2006-01-02 15:04:05.999999999",
			"2006-01-02 15:04:05",
		} {
			if value, err := time.Parse(layout, s); err == nil {
				return value
			}
		}
	case 114, 3802: // json, jsonb
		return append([]byte(nil), raw...)
	}
	return s
}
