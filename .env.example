NODE_ENV=development

POSTGRES_DB=trest
POSTGRES_USER=trest
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://trest:change-me@postgres:5432/trest?sslmode=disable

REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=trest
MINIO_ROOT_PASSWORD=change-me
STORAGE_ENDPOINT=minio:9000
STORAGE_BUCKET=trest

HTTP_PORT=8080
HTTPS_PORT=8443

AI_PROVIDER=local
AI_API_KEY=

# Never put a real token here.
GITHUB_TOKEN=

# BIM object storage (optional; when configured uses MinIO/S3-compatible storage)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=trest-bim
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
BIM_STORAGE_ROOT=./data/bim

ADMIN_PASSWORD=
